# Exotiq GTM environment template
# Do not commit real secrets. Production values belong in Netlify encrypted env vars.

# Keep mutation endpoints fail-closed until the admin token exists.
OUTREACH_MUTATIONS_ENABLED=false
OUTREACH_ADMIN_TOKEN=
OUTREACH_ADMIN_ACTOR=gregory

# Exotiq-specific GHL credentials. Do not fall back to AskSaul or other tenants.
GHL_EXOTIQ_API_KEY=
GHL_EXOTIQ_LOCATION_ID=hTOVcYDLS1UfuiNzuzpT
GHL_EXOTIQ_LOCATION_NAME=Exotiq Inc.

# GHL webhook verification. Prefer X-GHL-Signature Ed25519.
GHL_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAi2HR1srL4o18O8BRa7gVJY7G7bupbN3H9AwJrHCDiOg=\n-----END PUBLIC KEY-----"
GHL_EXOTIQ_WEBHOOK_LOCATION_ID=hTOVcYDLS1UfuiNzuzpT

# Sender posture for phase 1 US-only GTM.
EXOTIQ_GTM_PHASE1_COUNTRIES=US
EXOTIQ_GTM_PHASE2_COUNTRIES=GB,UK
