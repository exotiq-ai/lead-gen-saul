{
  "name": "saul-leadgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:unit": "tsx --test \"src/lib/**/*.test.ts\"",
    "lint": "eslint",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "git:push-main": "git pull --rebase origin main && git push origin main",
    "seed": "tsx scripts/seed.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "migrate": "tsx scripts/migrate.ts",
    "backfill-scores": "tsx scripts/backfill_scores.ts",
    "local-services:seed": "tsx scripts/local_services_outscraper.ts seed",
    "local-services:search": "tsx scripts/local_services_outscraper.ts search",
    "local-services:import": "tsx scripts/local_services_outscraper.ts import-file",
    "local-services:sync-ghl": "tsx scripts/local_services_outscraper.ts sync-ghl",
    "sendblue:webhooks": "tsx scripts/setup_sendblue_webhooks.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.104.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "html2canvas-pro": "^2.0.2",
    "lucide-react": "^1.9.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "svix": "^1.97.0",
    "swr": "^2.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
